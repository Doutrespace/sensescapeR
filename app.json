{
  "expo": {
    "name": "Sensescape Explorer",
    "slug": "soundscape-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon-mark.png",
    "userInterfaceStyle": "dark",
    "scheme": "soundscape",
    "splash": {
      "image": "./assets/splash-logo-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3EFE6"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs microphone access to record soundscapes for acoustic research.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to tag recordings with geographic data for soundscape mapping.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.anonymous.soundscapeapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE6",
        "foregroundImage": "./assets/icon-mark-transparent.png",
        "monochromeImage": "./assets/icon-mark-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.soundscapeapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "This app needs microphone access to record soundscapes for acoustic research.",
          "iosBackgroundMode": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ],
          "androidForegroundService": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7dd655ff-14dc-4140-b5a4-7faf5428ff2e"
      }
    }
  }
}
